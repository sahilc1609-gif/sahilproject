{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__vercel_path=/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "templates/**",
        "static/**",
        "sample/**",
        "config/**",
        "data/**"
      ]
    }
  }
}
